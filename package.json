  "keywords": ["evento", "fichas", "venda", "pdv", "maquininha", "impressão", "offline", "sync"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seuusuario/event-ticketing-app.git"
  },
  "bugs": {
    "url": "https://github.com/seuusuario/event-ticketing-app/issues"
},
"funding": {
